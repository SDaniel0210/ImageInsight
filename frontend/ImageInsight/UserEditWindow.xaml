<Window x:Class="ImageInsight.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User editor"
        Height="430"
        Width="375"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="2"
        BorderBrush="{DynamicResource ControlBorderBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource SurfaceBrush}">
        <StackPanel Margin="25" Width="320">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="20">
                    <TextBlock Text="👤" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                </Border>
                <TextBlock Text="Edit Profile" 
                       FontSize="22" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="15,0,0,0"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Text="Username" Margin="0,0,0,5" FontSize="12"/>
            <TextBox x:Name="UsernameTextBox" 
                 Height="35"
                 Margin="0,0,0,15"/>

            <TextBlock Text="Role" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox x:Name="RoleComboBox"
                  Height="35"
                  Margin="0,0,0,15">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
            </ComboBox>

            <TextBlock Text="Password" Margin="0,0,0,5" FontSize="12"/>
            <PasswordBox x:Name="PasswordBox"
                     Height="35"
                     Margin="0,0,0,8"/>

            <Border Background="{DynamicResource ElevatedSurfaceBrush}" 
                Padding="10" CornerRadius="5" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" FontWeight="Bold"/>
                    <TextBlock Text="Leave empty if you don't want to change it."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Width="240"/>
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                    Width="100" Height="35"
                    Margin="0,0,10,0"
                    Click="Save_Click"/>

                <Button Content="Cancel"
                    Width="100" Height="35"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="ImageInsight.ImageDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Details"
        Width="1200"
        Height="850"
        Background="{DynamicResource SurfaceBrush}"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Image Details"
                       FontSize="32"
                       FontWeight="Light"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Separator Background="{DynamicResource ControlBorderBrush}" Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">

                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Source Information" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                            <TextBlock Text="File name:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock x:Name="FileNameTextBlock" Margin="0,2,0,12" FontWeight="SemiBold" FontSize="14"/>

                            <TextBlock Text="Image URL:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock x:Name="ImageUrlTextBlock" TextWrapping="Wrap" Margin="0,2,0,12" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Text="Source URL:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock x:Name="SourceUrlTextBlock" TextWrapping="Wrap" Margin="0,2,0,12"/>

                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="Source type:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="SourceTypeTextBlock" Margin="0,2,0,12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Status:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="StatusTextBlock" Margin="0,2,0,12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="AI Analysis" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                            <TextBlock Text="Florence caption:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock x:Name="CaptionTextBlock" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="14" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" Padding="15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Validation &amp; Timeline" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Is validated:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="IsValidatedTextBlock" Margin="0,2,0,12"/>

                                    <TextBlock Text="Validation mode:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ValidationModeTextBlock" Margin="0,2,0,12"/>

                                    <TextBlock Text="Validated by:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ValidatedByTextBlock" Margin="0,2,0,12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Validation date:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ValidationDateTextBlock" Margin="0,2,0,12"/>

                                    <TextBlock Text="Database created at:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="DbCreatedAtTextBlock" Margin="0,2,0,12"/>

                                    <TextBlock Text="Windows file created date:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="FileCreatedDateTextBlock" Margin="0,2,0,12"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Tags &amp; Keywords" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="5,0,0,15"/>

                    <TextBlock Text="RAM++ tags:" Margin="5,0,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ListBox x:Name="RamTagsListBox" Height="150" Margin="0,0,0,15" />

                    <TextBlock Text="LLM tags:" Margin="5,0,0,5" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ListBox x:Name="LlmTagsListBox" Height="150" Margin="0,0,0,15"/>

                    <TextBlock Text="Final tags:" Margin="5,0,0,5" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <ListBox x:Name="FinalTagsListBox" Height="220" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="Close Details"
                    Width="150"
                    Height="40"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ShadowColor">#0EA5E9</Color> <!-- Button shadow -->
    <Color x:Key="AccentColor">#0284C7</Color> <!-- Button color -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F5F9"/> <!-- Main background -->
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF"/> <!-- Navigation, cards, Log background -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1"/> <!-- Borders -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/> <!-- Main text color -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569"/> <!-- 2nd text color -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/> <!-- Button -->

    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="NavigationPressedBrush" Color="#33000000"/>


    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1"> <!-- Button Gradient -->
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ShadowColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
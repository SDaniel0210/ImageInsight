<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ShadowColor">#0800A3</Color> <!-- Button shadow -->
    <Color x:Key="AccentColor">#6C63FF</Color> <!-- Button color -->

    <Color x:Key="NavigationHoverColor">#22FFFFFF</Color>
    <Color x:Key="NavigationPressedColor">#33FFFFFF</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#0F172A"/> <!-- Main background -->
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#1E293B"/> <!-- Navigation, cards, Log background -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#334155"/> <!-- Borders -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#CFE8EF"/> <!-- Main text color -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5B4FC"/> <!-- 2nd text color -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/> <!-- Button -->

    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="NavigationPressedBrush" Color="#33FFFFFF"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1"> <!-- Button Gradient -->
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ShadowColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
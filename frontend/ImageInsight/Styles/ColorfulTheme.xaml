<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ShadowColor">#D946EF</Color> <!-- Button shadow -->
    <Color x:Key="AccentColor">#A21CAF</Color> <!-- Button color -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1523"/> <!-- Main background -->
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#241B2F"/> <!-- Navigation, cards, Log background -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3B2C4A"/> <!-- Borders -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FCE7F3"/> <!-- Main text color -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#E9D5FF"/> <!-- 2nd text color -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/> <!-- Button -->

    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#22D946EF"/>
    <SolidColorBrush x:Key="NavigationPressedBrush" Color="#33D946EF"/>


    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1"> <!-- Button Gradient -->
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource ShadowColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
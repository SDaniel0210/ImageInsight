<Page x:Class="ImageInsight.ImagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource SurfaceBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Images"
                   FontSize="28"
                   FontWeight="Light"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="ImagesDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  LoadingRow="ImagesDataGrid_LoadingRow"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource ElevatedSurfaceBrush}"
                  BorderThickness="0">

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Preview" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="95" Height="65" Margin="5" CornerRadius="4"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                                    ClipToBounds="True">
                                <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Image URL" Binding="{Binding ImageUrl}" Width="2.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Final Tags" Binding="{Binding FinalTagsDisplay}" Width="2*"/>
                <DataGridTextColumn Header="Validation" Binding="{Binding ValidationDateDisplay}" Width="1*"/>
                <DataGridTextColumn Header="Created" Binding="{Binding FileCreatedDateDisplay}" Width="1*"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
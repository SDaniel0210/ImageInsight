<Page x:Class="ImageInsight.ValidationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="728"
      d:DesignWidth="1280">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top input/control bar -->
        <Border Background="{DynamicResource ElevatedSurfaceBrush}" 
            Padding="15,0">
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,10,0">

                    <TextBlock Text="Source path / URL:"
                   VerticalAlignment="Center"
                   FontSize="14"/>
                </StackPanel>

                <TextBox x:Name="SourcePathTextBox"
             Grid.Column="1"
             Height="30"
             VerticalContentAlignment="Center"
             Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2"
               Style="{StaticResource HelpIconStyle}">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock TextWrapping="Wrap"
                           Width="330"
                           Text="Click Load Images after entering a valid folder path or URL/path. The application will scan the source and collect supported image files into the validation list."/>
                        </ToolTip>
                    </TextBlock.ToolTip>
    </TextBlock>

                <Button x:Name="LoadImagesButton"
            Grid.Column="3"
            Content="Load Images"
            Width="110"
            Height="32"
            Margin="0,0,10,0"
            Click="LoadImages_Click"/>

                <Button x:Name="StartValidationButton"
            Grid.Column="4"
            Content="Start Validation"
            Width="130"
            Height="32"
            Margin="0,0,10,0"
            Click="StartValidation_Click"/>

                <Button x:Name="StopValidationButton"
            Grid.Column="5"
            Content="Stop Validation"
            Width="120"
            Height="32"
            Margin="0,0,10,0"
            Click="StopValidation_Click"/>

                <TextBlock x:Name="StatusTextBlock"
               Grid.Column="6"
               Text="Status: Idle"
               VerticalAlignment="Center"
               FontWeight="Bold"
               FontSize="14"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left info panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    Padding="15"
                    Margin="0,0,15,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
               Text="Validation info"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Located images:" FontWeight="Bold"/>
                        <TextBlock x:Name="LocatedImagesTextBlock" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Current:" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentImageTextBlock" Text="0 / 0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Is validated:" FontWeight="Bold"/>
                        <TextBlock x:Name="IsValidatedTextBlock" Text="False"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                            <TextBlock Style="{StaticResource HelpIconStyle}"
                       Width="16"
                       Height="16"
                       FontSize="11"
                       Margin="5,0,0,0">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                   Width="330"
                                   Text="Manual mode: the user reviews each image and chooses Accept or Decline. Auto mode: images are analyzed and saved automatically without user interaction."/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
            </TextBlock>
                        </StackPanel>

                        <TextBlock x:Name="ValidationModeTextBlock"
                   Text="Manual"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,15">
                        <TextBlock Text="Current file:" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentFileNameTextBlock"
                   Text="-"
                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="6"
                   Text="Tags:"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

                    <ListBox x:Name="TagsListBox"
             Grid.Row="8"
             VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Image validation area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Manual buttons -->
                <Grid Grid.Row="0"
            Margin="5,5,5,10">

                    <Button x:Name="DeclineButton"
            Content="Decline"
            Width="110"
            Height="35"
            HorizontalAlignment="Left"
            Style="{DynamicResource CloseButtonStyle}"
            Click="Decline_Click"/>

                    <Button x:Name="AcceptButton"
            Content="Accept"
            Width="110"
            Height="35"
            HorizontalAlignment="Right"
            Style="{DynamicResource AcceptButtonStyle}"
            Click="Accept_Click"/>

                </Grid>

                <!-- Drop / preview area -->
                <Border x:Name="ImageDropArea"
                        Grid.Row="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="2"
                        Background="{DynamicResource SurfaceBrush}"
                        AllowDrop="True"
                        Drop="ImageDropArea_Drop"
                        DragOver="ImageDropArea_DragOver">

                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="15"/>

                        <TextBlock x:Name="DropHintTextBlock"
                                   Text="Drop a single image here"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Previous / Next -->
                <Grid Grid.Row="2"
                      Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviousButton"
                            Grid.Column="0"
                            Content="Previous"
                            Width="120"
                            Height="40"
                            Click="Previous_Click"/>

                    <TextBlock x:Name="LastMessageTextBlock"
                               Grid.Column="1"
                               Text="Ready."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Button x:Name="NextButton"
                            Grid.Column="2"
                            Content="Next"
                            Width="120"
                            Height="40"
                            Click="Next_Click"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Page>